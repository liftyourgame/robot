{
  "custom": {},
  "params": {},
  "propConfig": {},
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": { "name": "HeaderBar" },
            "position": { "basis": "60px", "grow": 0, "shrink": 0 },
            "props": {
              "style": {
                "backgroundColor": "#1a1a2e",
                "alignItems": "center",
                "padding": "0 24px",
                "display": "flex",
                "justifyContent": "space-between"
              }
            },
            "type": "ia.container.flex",
            "children": [
              {
                "meta": { "name": "Title" },
                "position": {},
                "props": {
                  "text": "🏭  HUMN Factory — 3D Print Monitor",
                  "style": {
                    "color": "#e0e0ff",
                    "fontSize": "20px",
                    "fontWeight": "bold",
                    "fontFamily": "monospace"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": { "name": "LastUpdated" },
                "position": {},
                "props": {
                  "text": {
                    "binding": {
                      "type": "tag",
                      "config": {
                        "tagPath": "[default]Factory/Printer/last_updated",
                        "fallbackDelay": 2.5
                      }
                    }
                  },
                  "style": { "color": "#888", "fontSize": "12px", "fontFamily": "monospace" }
                },
                "type": "ia.display.label"
              }
            ]
          },
          {
            "meta": { "name": "MainContent" },
            "position": { "grow": 1 },
            "props": {
              "direction": "row",
              "wrap": "wrap",
              "style": {
                "backgroundColor": "#0d0d1a",
                "padding": "16px",
                "gap": "16px",
                "alignContent": "flex-start"
              }
            },
            "type": "ia.container.flex",
            "children": [

              {
                "meta": { "name": "CameraCard" },
                "position": { "basis": "560px", "grow": 1 },
                "props": {
                  "style": {
                    "backgroundColor": "#1a1a2e",
                    "borderRadius": "8px",
                    "padding": "12px",
                    "border": "1px solid #2a2a4e"
                  }
                },
                "type": "ia.container.flex",
                "children": [
                  {
                    "meta": { "name": "CameraLabel" },
                    "position": { "basis": "28px", "shrink": 0 },
                    "props": {
                      "text": "📷  Live Camera Feed — Tapo TC60",
                      "style": { "color": "#a0a0cc", "fontWeight": "bold", "fontSize": "13px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "CameraImage" },
                    "position": { "grow": 1 },
                    "props": {
                      "source": "http://localhost:8090/stream",
                      "style": {
                        "width": "100%",
                        "borderRadius": "4px",
                        "minHeight": "300px",
                        "objectFit": "contain",
                        "backgroundColor": "#000"
                      },
                      "autoreload": true,
                      "reloadRate": 100
                    },
                    "type": "ia.display.image"
                  }
                ]
              },

              {
                "meta": { "name": "StatusCard" },
                "position": { "basis": "280px", "grow": 0 },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#1a1a2e",
                    "borderRadius": "8px",
                    "padding": "12px",
                    "border": "1px solid #2a2a4e",
                    "gap": "10px"
                  }
                },
                "type": "ia.container.flex",
                "children": [
                  {
                    "meta": { "name": "StatusLabel" },
                    "position": { "basis": "28px", "shrink": 0 },
                    "props": {
                      "text": "🖨️  Print Status",
                      "style": { "color": "#a0a0cc", "fontWeight": "bold", "fontSize": "13px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "StateDisplay" },
                    "position": { "basis": "44px", "shrink": 0 },
                    "props": {
                      "text": {
                        "binding": {
                          "type": "tag",
                          "config": { "tagPath": "[default]Factory/Printer/gcode_state" }
                        }
                      },
                      "style": {
                        "fontSize": "22px",
                        "fontWeight": "bold",
                        "fontFamily": "monospace",
                        "color": "#00ff88",
                        "textAlign": "center"
                      }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "SubtaskName" },
                    "position": { "basis": "20px", "shrink": 0 },
                    "props": {
                      "text": {
                        "binding": {
                          "type": "tag",
                          "config": { "tagPath": "[default]Factory/Printer/subtask_name" }
                        }
                      },
                      "style": { "fontSize": "11px", "color": "#666", "fontFamily": "monospace", "textAlign": "center" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "ProgressBar" },
                    "position": { "basis": "50px", "shrink": 0 },
                    "props": {
                      "value": {
                        "binding": {
                          "type": "tag",
                          "config": { "tagPath": "[default]Factory/Printer/print_percent" }
                        }
                      },
                      "max": 100,
                      "min": 0,
                      "style": { "height": "20px" },
                      "label": {
                        "visible": true,
                        "text": {
                          "binding": {
                            "type": "expr",
                            "config": {
                              "expression": "toStr({[default]Factory/Printer/print_percent}) + '%  —  Layer ' + toStr({[default]Factory/Printer/layer_num}) + ' / ' + toStr({[default]Factory/Printer/total_layer_num})"
                            }
                          }
                        }
                      }
                    },
                    "type": "ia.display.progressBar"
                  },
                  {
                    "meta": { "name": "RemainingTime" },
                    "position": { "basis": "20px", "shrink": 0 },
                    "props": {
                      "text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "'⏱  ' + toStr({[default]Factory/Printer/remaining_minutes}) + ' min remaining'"
                          }
                        }
                      },
                      "style": { "color": "#a0a0cc", "fontSize": "12px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  }
                ]
              },

              {
                "meta": { "name": "TemperatureCard" },
                "position": { "basis": "280px", "grow": 0 },
                "props": {
                  "direction": "column",
                  "style": {
                    "backgroundColor": "#1a1a2e",
                    "borderRadius": "8px",
                    "padding": "12px",
                    "border": "1px solid #2a2a4e",
                    "gap": "8px"
                  }
                },
                "type": "ia.container.flex",
                "children": [
                  {
                    "meta": { "name": "TempLabel" },
                    "position": { "basis": "28px", "shrink": 0 },
                    "props": {
                      "text": "🌡️  Temperatures",
                      "style": { "color": "#a0a0cc", "fontWeight": "bold", "fontSize": "13px", "fontFamily": "monospace" }
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": { "name": "NozzleRow" },
                    "position": { "basis": "32px", "shrink": 0 },
                    "props": {
                      "direction": "row",
                      "style": { "justifyContent": "space-between", "alignItems": "center" }
                    },
                    "type": "ia.container.flex",
                    "children": [
                      {
                        "meta": { "name": "NozzleIcon" },
                        "position": {},
                        "props": { "text": "🔴 Nozzle", "style": { "color": "#ff6644", "fontFamily": "monospace", "fontSize": "13px" } },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "NozzleVal" },
                        "position": {},
                        "props": {
                          "text": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "toStr({[default]Factory/Printer/nozzle_temp}) + '°C  →  ' + toStr({[default]Factory/Printer/nozzle_target}) + '°C'"
                              }
                            }
                          },
                          "style": { "color": "#ff6644", "fontFamily": "monospace", "fontSize": "14px", "fontWeight": "bold" }
                        },
                        "type": "ia.display.label"
                      }
                    ]
                  },
                  {
                    "meta": { "name": "BedRow" },
                    "position": { "basis": "32px", "shrink": 0 },
                    "props": {
                      "direction": "row",
                      "style": { "justifyContent": "space-between", "alignItems": "center" }
                    },
                    "type": "ia.container.flex",
                    "children": [
                      {
                        "meta": { "name": "BedIcon" },
                        "position": {},
                        "props": { "text": "🟠 Bed", "style": { "color": "#ffaa44", "fontFamily": "monospace", "fontSize": "13px" } },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "BedVal" },
                        "position": {},
                        "props": {
                          "text": {
                            "binding": {
                              "type": "tag",
                              "config": { "tagPath": "[default]Factory/Printer/bed_temp" }
                            }
                          },
                          "format": "0.0°C",
                          "style": { "color": "#ffaa44", "fontFamily": "monospace", "fontSize": "14px", "fontWeight": "bold" }
                        },
                        "type": "ia.display.label"
                      }
                    ]
                  },
                  {
                    "meta": { "name": "ChamberRow" },
                    "position": { "basis": "32px", "shrink": 0 },
                    "props": {
                      "direction": "row",
                      "style": { "justifyContent": "space-between", "alignItems": "center" }
                    },
                    "type": "ia.container.flex",
                    "children": [
                      {
                        "meta": { "name": "ChamberIcon" },
                        "position": {},
                        "props": { "text": "🔵 Chamber", "style": { "color": "#44aaff", "fontFamily": "monospace", "fontSize": "13px" } },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "ChamberVal" },
                        "position": {},
                        "props": {
                          "text": {
                            "binding": {
                              "type": "tag",
                              "config": { "tagPath": "[default]Factory/Printer/chamber_temp" }
                            }
                          },
                          "format": "0.0°C",
                          "style": { "color": "#44aaff", "fontFamily": "monospace", "fontSize": "14px", "fontWeight": "bold" }
                        },
                        "type": "ia.display.label"
                      }
                    ]
                  },
                  {
                    "meta": { "name": "FanRow" },
                    "position": { "basis": "32px", "shrink": 0 },
                    "props": {
                      "direction": "row",
                      "style": { "justifyContent": "space-between", "alignItems": "center" }
                    },
                    "type": "ia.container.flex",
                    "children": [
                      {
                        "meta": { "name": "FanIcon" },
                        "position": {},
                        "props": { "text": "💨 Fan", "style": { "color": "#88ccff", "fontFamily": "monospace", "fontSize": "13px" } },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": { "name": "FanVal" },
                        "position": {},
                        "props": {
                          "text": {
                            "binding": {
                              "type": "expr",
                              "config": {
                                "expression": "toStr({[default]Factory/Printer/fan_speed_pct}) + '%'"
                              }
                            }
                          },
                          "style": { "color": "#88ccff", "fontFamily": "monospace", "fontSize": "14px", "fontWeight": "bold" }
                        },
                        "type": "ia.display.label"
                      }
                    ]
                  },

                  {
                    "meta": { "name": "TempHistoryChart" },
                    "position": { "grow": 1 },
                    "props": {
                      "traces": [
                        {
                          "name": "Nozzle",
                          "tagPath": "[default]Factory/Printer/nozzle_temp",
                          "color": "#ff6644"
                        },
                        {
                          "name": "Bed",
                          "tagPath": "[default]Factory/Printer/bed_temp",
                          "color": "#ffaa44"
                        },
                        {
                          "name": "Chamber",
                          "tagPath": "[default]Factory/Printer/chamber_temp",
                          "color": "#44aaff"
                        }
                      ],
                      "showLegend": true,
                      "rangeMode": "relative",
                      "relativeRange": "PT1H",
                      "style": {
                        "width": "100%",
                        "minHeight": "160px"
                      }
                    },
                    "type": "ia.chart.timeSeries"
                  }
                ]
              }

            ]
          }
        ],
        "meta": { "name": "PageLayout" },
        "position": { "grow": 1 },
        "props": {
          "direction": "column",
          "style": {
            "width": "100%",
            "height": "100%"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": { "name": "root" },
    "position": {},
    "props": {
      "style": {
        "backgroundColor": "#0d0d1a",
        "width": "100%",
        "height": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}
